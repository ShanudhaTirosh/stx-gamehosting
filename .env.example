# Copy to .env and fill in. Never commit .env.

# --- REQUIRED ---------------------------------------------------------------
APP_URL=https://hosting.example.lk
# Generate once:  echo "base64:$(head -c 32 /dev/urandom | base64)"
APP_KEY=
DB_ROOT_PASSWORD=
DB_PASSWORD=

# --- Where things live -------------------------------------------------------
#   /            storefront (public website)
#   /app         client panel: customers sign in here and manage their servers
#   /admin       admin panel
# Change the client panel's path here if you want something other than /app.
APP_CLIENT_PATH=app

# --- Database ---------------------------------------------------------------
DB_DATABASE=panel
DB_USER=pelican

# --- Mail (order emails, contact form) -------------------------------------
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=billing@stxenterprises.lk

# --- Hosting platform -------------------------------------------------------
# Nodes need one of these tags to receive new servers (Admin > Nodes > Tags).
HOSTING_NODE_TAGS=game-node
# Where the automatic per-server database accepts connections from.
# '%' = anywhere (Pelican default). Prefer your game node IP, and firewall the DB host.
HOSTING_DATABASE_REMOTE=%
