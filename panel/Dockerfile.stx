# STX Enterprises - Pre-configured Unified Panel Image
# Base: Official Pelican Panel release image
FROM ghcr.io/pelican/panel:latest

LABEL maintainer="STX Enterprises Lanka (Pvt) Ltd"
LABEL description="STX Enterprises Commercial Cloud & Game Server Panel with pre-configured plugins"

USER root

# 1. Copy pre-installed plugins into the container webroot with correct ownership
COPY --chown=www-data:www-data ./plugins /var/www/html/plugins

# 2. Copy branded layouts, providers, custom dashboard widgets & translations
COPY --chown=www-data:www-data ./resources/views/filament/layouts/footer.blade.php /var/www/html/resources/views/filament/layouts/footer.blade.php
COPY --chown=www-data:www-data ./app/Providers/Filament/FilamentServiceProvider.php /var/www/html/app/Providers/Filament/FilamentServiceProvider.php
COPY --chown=www-data:www-data ./app/Providers/Filament/AppPanelProvider.php /var/www/html/app/Providers/Filament/AppPanelProvider.php
COPY --chown=www-data:www-data ./app/Providers/Filament/AdminPanelProvider.php /var/www/html/app/Providers/Filament/AdminPanelProvider.php
COPY --chown=www-data:www-data ./app/Filament/App/Resources/Servers/ServerResource.php /var/www/html/app/Filament/App/Resources/Servers/ServerResource.php
COPY --chown=www-data:www-data ./app/Filament/App/Resources/Servers/Pages/ListServers.php /var/www/html/app/Filament/App/Resources/Servers/Pages/ListServers.php
COPY --chown=www-data:www-data ./app/Enums/CustomizationKey.php /var/www/html/app/Enums/CustomizationKey.php
COPY --chown=www-data:www-data ./app/Http/Controllers/Auth/OAuthController.php /var/www/html/app/Http/Controllers/Auth/OAuthController.php
COPY --chown=www-data:www-data ./app/Http/Middleware/RedirectIfAuthenticated.php /var/www/html/app/Http/Middleware/RedirectIfAuthenticated.php
COPY --chown=www-data:www-data ./app/Http/Responses/LoginResponse.php /var/www/html/app/Http/Responses/LoginResponse.php
COPY --chown=www-data:www-data ./config/panel.php /var/www/html/config/panel.php
COPY --chown=www-data:www-data ./routes/auth.php /var/www/html/routes/auth.php
COPY --chown=www-data:www-data ./app/Filament/Admin/Widgets /var/www/html/app/Filament/Admin/Widgets
COPY --chown=www-data:www-data ./app/Filament/Admin/Pages/Dashboard.php /var/www/html/app/Filament/Admin/Pages/Dashboard.php
COPY --chown=www-data:www-data ./resources/views/filament/widgets /var/www/html/resources/views/filament/widgets
COPY --chown=www-data:www-data ./lang/en/admin/dashboard.php /var/www/html/lang/en/admin/dashboard.php

# 3. Ensure permissions and pre-resolve plugin dependencies
RUN chmod -R 775 /var/www/html/plugins \
    && su www-data -s /bin/ash -c "php artisan p:plugin:composer" \
    && su www-data -s /bin/ash -c "php artisan filament:optimize" \
    && su www-data -s /bin/ash -c "php artisan view:cache"

