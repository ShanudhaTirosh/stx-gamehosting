+    /**
+     * Called by the queue after the final attempt failed.
+     */
+    public function failed(Throwable $exception): void
+    {
+        HostingOrder::query()
+            ->whereKey($this->orderId)
+            ->where('status', OrderStatus::Provisioning->value)
+            ->update(['status' => OrderStatus::Approved]);
